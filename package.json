{
  "name": "visual-agents-office",
  "version": "0.1.0",
  "description": "A pixel-art office that shows your running Claude Code agents and what they are doing.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
