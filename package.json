{
  "name": "visual-agents-office",
  "version": "1.0.0",
  "description": "A live pixel-art office that shows your running Claude Code agents, their subagents and who is waiting for you.",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "hooks",
    "dashboard",
    "pixel-art"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "visual-agents-office": "bin/visual-agents-office.js"
  },
  "files": [
    "bin/",
    "server/",
    "hooks/",
    "web/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/visual-agents-office.js",
    "setup": "node bin/visual-agents-office.js setup",
    "uninstall-hooks": "node bin/visual-agents-office.js uninstall",
    "install-hooks": "node bin/visual-agents-office.js setup",
    "demo": "node bin/visual-agents-office.js demo",
    "test": "node --test test/*.test.js"
  }
}
